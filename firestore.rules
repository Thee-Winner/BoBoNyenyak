rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == 'admin';
    }

    // Koleksi users
    match /users/{userId} {
      // Pengguna membaca profil sendiri; admin dapat membaca profil apa pun.
      allow get: if isOwner(userId) || isAdmin();

      // Dibutuhkan dashboard admin untuk menghitung pengguna.
      allow list: if isAdmin();

      // Saat registrasi, pengguna hanya boleh membuat profil miliknya
      // dengan role user.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Pengguna boleh mengubah nama/email, tetapi tidak UID atau role.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['name', 'email', 'updatedAt']);

      allow delete: if false;

      // ─────────────────────────────────────────────────────────────
      // Subcollection babyProfiles
      // Path: users/{userId}/babyProfiles/{babyId}
      // ─────────────────────────────────────────────────────────────
      match /babyProfiles/{babyId} {
        // Pengguna hanya boleh membaca, membuat, dan memperbarui profil bayi miliknya sendiri
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.birthDate is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        // ─────────────────────────────────────────────────────────────
        // Subcollection sleepRecords
        // Path: users/{userId}/babyProfiles/{babyId}/sleepRecords/{recordId}
        // ─────────────────────────────────────────────────────────────
        match /sleepRecords/{recordId} {
          // Pengguna hanya boleh mengelola catatan tidur bayi miliknya sendiri
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.startAt is timestamp
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
